{
  "info": {
    "name": "Filtros de pesquisa — laboratório sintético descartável",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const base=pm.environment.get('labBaseUrl') || '';",
          "if (pm.environment.get('laboratorioDescartavel') !== 'SIM' || !/^http:\\/\\/127\\.0\\.0\\.1(?::[0-9]+)?\\/sei\\/modulos\\/wssei\\/controlador_ws\\.php\\/api\\/v2$/.test(base)) { pm.execution.skipRequest(); throw new Error('Somente laboratório local descartável'); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Série 321: só documentos desta série",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "token",
            "value": "{{token}}"
          }
        ],
        "url": "{{labBaseUrl}}/processo/pesquisar?idSerie=321&limit=10&start=0"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 e envelope', () => { pm.response.to.have.status(200); const r=pm.response.json(); pm.expect(r.sucesso).to.eql(true); pm.expect(r.data).to.be.an('array'); pm.expect(Number(r.total)).to.be.at.least(r.data.length); });",
              "pm.test('Ocorrências documentais exatas', () => { const r=pm.response.json(); pm.expect(r.data.map(x=>String(x.documento.idDocumento))).to.eql([\"2004\", \"2003\", \"2001\"]); pm.expect(Number(r.total)).to.eql(3); });"
            ]
          }
        }
      ]
    },
